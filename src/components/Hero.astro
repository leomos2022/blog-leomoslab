---
const stats = [
  { number: "5+", label: "Años de Experiencia" },
  { number: "50+", label: "Proyectos Exitosos" },
  { number: "30+", label: "Clientes Satisfechos" },
  { number: "100%", label: "Compromiso" },
];
---

<section class="relative pt-32 pb-20 lg:pt-40 lg:pb-32 overflow-hidden">
  <!-- Background gradient -->
  <div class="absolute inset-0 bg-gradient-to-br from-blue-900/20 via-slate-900 to-slate-900 -z-10"></div>
  
  <div class="container mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Text Content -->
      <div class="space-y-8">
        <div class="space-y-4">
          <p class="text-blue-400 font-semibold text-lg">Soy Leomos Lab</p>
          <h1 class="text-4xl lg:text-6xl font-bold leading-tight">
            Creo Soluciones de Software para Impulsar tu Negocio
          </h1>
          <p class="text-slate-400 text-lg leading-relaxed">
            Con un portafolio de proyectos exitosos en diversas industrias, 
            he demostrado consistentemente la capacidad de transformar 
            ideas en productos digitales de alto impacto.
          </p>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-2 gap-6">
          {stats.map((stat) => (
            <div class="space-y-1">
              <div class="text-3xl font-bold text-blue-400">{stat.number}</div>
              <div class="text-slate-400 text-sm">{stat.label}</div>
            </div>
          ))}
        </div>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4">
          <button class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-4 rounded-lg font-semibold transition-all duration-200 hover:scale-105">
            Empezar Proyecto
          </button>
          <button class="border-2 border-slate-700 hover:border-blue-600 text-white px-8 py-4 rounded-lg font-semibold transition-all duration-200">
            Ver Portafolio
          </button>
        </div>
      </div>

      <!-- Images -->
      <div class="relative">
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-4 mt-8">
            <div class="bg-slate-800 rounded-2xl p-6 h-64 flex items-center justify-center">
              <div class="text-center">
                <div class="text-6xl mb-2">💻</div>
                <p class="text-slate-400">Desarrollo Web</p>
              </div>
            </div>
            <div class="bg-gradient-to-br from-blue-600 to-blue-700 rounded-2xl p-6 h-48 flex items-center justify-center">
              <div class="text-center">
                <div class="text-6xl mb-2">🚀</div>
                <p class="text-white">Innovación</p>
              </div>
            </div>
          </div>
          <div class="space-y-4">
            <div class="bg-gradient-to-br from-purple-600 to-purple-700 rounded-2xl p-6 h-48 flex items-center justify-center">
              <div class="text-center">
                <div class="text-6xl mb-2">📱</div>
                <p class="text-white">Mobile Apps</p>
              </div>
            </div>
            <div class="bg-slate-800 rounded-2xl p-6 h-64 flex items-center justify-center">
              <div class="text-center">
                <div class="text-6xl mb-2">🎨</div>
                <p class="text-slate-400">UI/UX Design</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>