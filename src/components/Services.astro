---
const services = [
  {
    icon: "💻",
    title: "Desarrollo Web",
    description: "Aplicaciones web modernas con React, Astro y las últimas tecnologías.",
    features: ["React 19", "Astro", "Node.js"]
  },
  {
    icon: "📱",
    title: "Apps Móviles",
    description: "Desarrollo nativo y multiplataforma para iOS y Android.",
    features: ["React Native", "Flutter", "iOS & Android"]
  },
  {
    icon: "🎨",
    title: "Diseño UI/UX",
    description: "Interfaces intuitivas y experiencias de usuario excepcionales.",
    features: ["Figma", "User Research", "Prototyping"]
  },
  {
    icon: "☁️",
    title: "Cloud & DevOps",
    description: "Infraestructura escalable y despliegue continuo.",
    features: ["AWS", "Vercel", "CI/CD"]
  },
  {
    icon: "🤖",
    title: "Inteligencia Artificial",
    description: "Integración de IA y machine learning en tus productos.",
    features: ["Machine Learning", "NLP", "Computer Vision"]
  },
  {
    icon: "📊",
    title: "Análisis de Datos",
    description: "Transformamos datos en insights accionables.",
    features: ["Data Science", "Analytics", "Dashboards"]
  }
];
---

<section id="servicios" class="py-20 bg-slate-800/50">
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-3xl lg:text-5xl font-bold mb-4">Mis Servicios</h2>
      <p class="text-slate-400 text-lg max-w-2xl mx-auto">
        Soluciones tecnológicas completas para llevar tu negocio al siguiente nivel
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map((service) => (
        <div class="bg-slate-900 rounded-2xl p-8 hover:scale-105 transition-transform duration-300 border border-slate-800">
          <div class="text-5xl mb-4">{service.icon}</div>
          <h3 class="text-xl font-bold mb-3">{service.title}</h3>
          <p class="text-slate-400 mb-4">{service.description}</p>
          <div class="flex flex-wrap gap-2">
            {service.features.map((feature) => (
              <span class="bg-blue-600/20 text-blue-400 px-3 py-1 rounded-full text-sm">
                {feature}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>